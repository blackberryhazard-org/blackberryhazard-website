---
import { config } from '../config';
import { Icon } from 'astro-icon/components';
---
<footer class="w-full border-t border-border bg-background py-8 md:py-12">
  <div class="container mx-auto px-4 md:px-6">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href="/" class="font-bold text-2xl tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-primary-500 to-primary-600">
          {config.title}
        </a>
      </div>

      <div class="space-y-4">
        <h4 class="font-semibold text-foreground">Menu</h4>
        <nav class="flex flex-col space-y-2">
          <a href="#community" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Komunitas</a>
          <a href="https://imphnen.dev/events" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Event</a>
          <a href="https://imphnen.dev/testimonials" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Testimoni</a>
        </nav>
      </div>

      <div class="space-y-4">
        <h4 class="font-semibold text-foreground">Legal</h4>
        <nav class="flex flex-col space-y-2">
          <a href="#" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Privacy Policy</a>
          <a href="#" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Terms of Service</a>
        </nav>
      </div>

      <div class="space-y-4">
        <h4 class="font-semibold text-foreground">Sosial</h4>
        <div class="flex gap-4">
          <a href="https://github.com/IMPHNEN" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">
            <span class="sr-only">GitHub</span>
            <Icon name="fa6-brands:github" class="h-5 w-5" />
          </a>
          <a href="https://discord.gg/imphnen" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">
            <span class="sr-only">Discord</span>
            <Icon name="fa6-brands:discord" class="h-5 w-5" />
          </a>
        </div>
      </div>
    </div>
    <div class="mt-8 border-t border-border pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} IMPHNEN. All rights reserved.
      </p>
    </div>
  </div>
</footer>
