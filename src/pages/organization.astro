---
import '../index.css';
import { Navbar } from '../components/Navbar';
import { Footer } from '../components/Footer';
import { OrganizationPage } from '../components/OrganizationPage';
import { config } from '../config';
import { SEO } from "astro-seo";

const lang = config.language.split('-')[0];
const siteUrl = config.url.replace(/\/$/, '');
const ogImage = `${siteUrl}/${config.thumbnail.replace(/^\.\//, '')}`;
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%93%B1%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={favicon} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0e150f" />

    <SEO
      title={`Organization - ${config.title}`}
      description="Tentang BlackberryHazard - Komunitas IT & Gamer Indonesia"
      canonical={`${siteUrl}/organization`}
      openGraph={{
        basic: {
          title: `Organization - ${config.title}`,
          type: "website",
          image: ogImage,
          url: `${siteUrl}/organization`,
        },
        optional: {
          description: "Tentang BlackberryHazard - Komunitas IT & Gamer Indonesia",
          siteName: config.title,
          locale: config.language.replace('-', '_'),
        }
      }}
      twitter={{
        card: "summary_large_image",
        title: `Organization - ${config.title}`,
        description: "Tentang BlackberryHazard - Komunitas IT & Gamer Indonesia",
        image: ogImage,
      }}
    />

    <script defer src="https://cloud.umami.is/script.js" data-website-id="8425d2fd-c98b-4a2a-afc0-c033de3baa14"></script>
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col relative overflow-x-hidden font-sans">
    <Navbar client:load />
    <main class="flex-1 scroll-smooth">
      <OrganizationPage client:load />
    </main>
    <Footer client:idle />
  </body>
</html>
