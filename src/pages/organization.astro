---
import BaseLayout from '../layouts/BaseLayout.astro';
import { OrganizationPage } from '../components/OrganizationPage';
import { JoinCta } from '../components/JoinCta';
import { config } from '../config';
---

<BaseLayout
  title={`Organization - ${config.title}`}
  description="Tentang BlackberryHazard - Komunitas IT & Gamer Indonesia"
>
  <OrganizationPage client:load />
  <JoinCta
    client:load
    titleText1="JOIN OUR"
    titleText2="GITHUB"
    titleText3="ORG"
    titleText4=""
    description="Tertarik berkontribusi pada project open source BlackberryHazard? Gabung ke GitHub Organization kami sekarang dan mari berkolaborasi!"
    buttonText="Join GitHub Org"
    href="mailto:cihuysomnia@proton.me"
  />
</BaseLayout>
